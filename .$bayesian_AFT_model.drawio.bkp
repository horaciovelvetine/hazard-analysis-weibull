        </mxCell>
        <mxCell id="6k8TRL5pe4t5XE-6ocAw-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Z-Score standardization for continuous features. This handles variables of different magnitudes (years vs percentages) so that no single factor dominates the Bayesian calculation by scale alone." vertex="1">
          <mxGeometry height="80" width="540" x="260" y="240" as="geometry" />
        </mxCell>
        <mxCell id="5gTYLFnqKiTyZw7fIl-q-6" edge="1" parent="1" source="AZ8nOocg90WcONrICoo1-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="AZ8nOocg90WcONrICoo1-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AZ8nOocg90WcONrICoo1-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Bayesian Priors" vertex="1">
          <mxGeometry height="40" width="120" x="80" y="380" as="geometry" />
        </mxCell>
        <mxCell id="5gTYLFnqKiTyZw7fIl-q-9" edge="1" parent="1" source="AZ8nOocg90WcONrICoo1-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="AZ8nOocg90WcONrICoo1-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AZ8nOocg90WcONrICoo1-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Normal distributions with small sigma (0.5) are used to regularize the model, preventing extreme predictions and ensuring it learns a typical bell-curve influence for each feature." vertex="1">
          <mxGeometry height="80" width="540" x="260" y="360" as="geometry" />
        </mxCell>
        <mxCell id="5gTYLFnqKiTyZw7fIl-q-5" edge="1" parent="1" source="AZ8nOocg90WcONrICoo1-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="AZ8nOocg90WcONrICoo1-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AZ8nOocg90WcONrICoo1-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Weibull" vertex="1">
          <mxGeometry height="40" width="120" x="80" y="500" as="geometry" />
        </mxCell>
        <mxCell id="5gTYLFnqKiTyZw7fIl-q-10" edge="1" parent="1" source="AZ8nOocg90WcONrICoo1-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="oYlJY1q3z8058ByLadpT-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="AZ8nOocg90WcONrICoo1-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="The core likelihood step. Uses the Alpha (Shape) parameter to detect &#39;Wear-out&#39; failure patterns&amp;nbsp; &amp;nbsp; &amp;nbsp; (α &amp;gt; 1). Connects η (linear predictor) to β (time-to-failure scale) via an exponential link" vertex="1">
          <mxGeometry height="80" width="540" x="260" y="480" as="geometry" />
        </mxCell>
        <mxCell id="5gTYLFnqKiTyZw7fIl-q-3" edge="1" parent="1" source="AZ8nOocg90WcONrICoo1-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="AZ8nOocg90WcONrICoo1-19" value="">
