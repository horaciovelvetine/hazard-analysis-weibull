        </mxCell>
        <mxCell id="AZ8nOocg90WcONrICoo1-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&amp;nbsp;Transforms Predicted Time-to-Failure (years) into an instantaneous Hazard Score (1/μ). Assets are then sorted by hazard score to generate the global risk ranking." vertex="1">
          <mxGeometry height="80" width="540" x="260" y="720" as="geometry" />
        </mxCell>
