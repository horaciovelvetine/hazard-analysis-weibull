        <mxCell id="6k8TRL5pe4t5XE-6ocAw-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Data Ingestion" vertex="1">
          <mxGeometry height="40" width="120" x="80" y="140" as="geometry" />
