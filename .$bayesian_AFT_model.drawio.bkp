        </mxCell>
        <mxCell id="6k8TRL5pe4t5XE-6ocAw-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Merge asset condition indices with historical work orders. Assets without failure events are flagged as &#39;Censored&#39;, ensuring the model accounts for infrastructure still in service." vertex="1">
          <mxGeometry height="80" width="540" x="260" y="120" as="geometry" />
        </mxCell>
        <mxCell id="5gTYLFnqKiTyZw7fIl-q-2" edge="1" parent="1" source="6k8TRL5pe4t5XE-6ocAw-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="6k8TRL5pe4t5XE-6ocAw-11" value="">
